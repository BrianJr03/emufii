<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped as tightly as the platform allows: events from the Azahar and Eden
  packages only, no others. Emufii never reads the rest of the screen.

  The file keeps its Azahar name for the same reason the service class does:
  renaming the component would silently switch the automation off for everyone
  who had already enabled it.

  `packageNames` is a second package list, and it is easy to forget. An
  emulator missing from here produces no accessibility event at all: the
  service never wakes, the form is never filled, and there is no error and no
  log line, so the tap simply looks inert. That is what happened to Eden's
  "Optimized" variants, which declare themselves under Genshin Impact's
  identity: listed in `<queries>`, so detected, but mute to the service.

  This list must therefore mirror `NetplayTarget.all`, `DolphinTarget.packages`
  and `Ps2Target.packages`. Dolphin is driven by the same service through a
  separate driver, its screen being Compose with no view ids. A test compares
  the two lists (`PackageVisibilityTest`); the compiler does not read this
  file.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/netplay_service_description"
    android:notificationTimeout="100"
    android:packageNames="org.azahar_emu.azahar,org.azahar_emu.azahar.debug,io.github.lime3ds.android,dev.eden.eden_emulator,dev.eden.eden_emulator.nightly,dev.eden.eden_emulator.emufii,com.miHoYo.Yuanshen,com.miHoYo.Yuanshen.nightly,dev.legacy.eden_emulator,org.dolphinemu.dolphinemu,org.dolphinemu.dolphinemu.debug,com.armsx2"
    android:settingsActivity="eu.emufii.app.MainActivity" />
