<?xml version="1.0" encoding="utf-8"?>
<!--
  The v3 logo is a square, cut-out drawing (two offset rounded tiles, ~1:1).
  Unlike the v2 it brings no background of its own, so it is the foreground
  layer and the background is flat white.

  It is scaled to 54/108 of the frame, half, well inside the 72/108 safety
  square. No launcher mask, round or squircle, can clip the tile corners, and
  the margin is deliberately wider than needed: placed at the safety square,
  the drawing filled the badge and the icon lost its white edge. Taken down to
  60/108 then to 54, on device, 2026-08-25.

  `monochrome` is the silhouette of the drawing for the Android 13 themed
  icons, the ones the Thor uses. The system keeps only its alpha channel, so
  the light areas of the logo (the centre plate, the D-pad, the buttons) are
  holes there, which is what keeps the E readable once tinted. The v2 mono was
  an opaque fill and would have shown up as a solid block.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_art" />
    <monochrome android:drawable="@mipmap/ic_launcher_mono" />
</adaptive-icon>
